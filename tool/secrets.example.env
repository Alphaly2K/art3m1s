# Art3m1s 本地密钥模板。复制为 tool/secrets.local.env 并填入真实值；
# secrets.local.env 已被 .gitignore 排除，任何情况下不要提交。
#
# 生效优先级：环境变量 > tool/secrets.local.env。
# tool/build.dart 会把 SENTRY_DSN 转成 --dart-define 注入应用，
# 并把 SENTRY_AUTH_TOKEN 传给 sentry_dart_plugin 用于符号上传。

# 应用内错误/崩溃上报的接入点（Sentry 项目 DSN）：
SENTRY_DSN=

# 上传调试符号所需（CI 或本机符号上传时填写）：
SENTRY_AUTH_TOKEN=
